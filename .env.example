# Copy this file to .env and paste your key to enable real AI search via Groq.
# Without a key, the app automatically falls back to a local demo mode (client-side relevance heuristic).
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Optionally change the model (defaults to gpt-oss-20b — check https://console.groq.com/docs/models
# for what's currently available on your account, since Groq's catalog changes over time)
GROQ_MODEL=openai/gpt-oss-20b
