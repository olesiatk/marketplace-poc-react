# Copy this file to .env and fill in your Algolia app's credentials to enable search.
# Create an app (or reuse an existing one) at https://dashboard.algolia.com/

# App ID and a search-only API key — safe to expose to the client, read via import.meta.env.
VITE_ALGOLIA_APPLICATION_ID=
VITE_ALGOLIA_SEARCH_API_KEY=

# A write API key — deliberately NOT VITE_-prefixed, so it's never bundled into
# client code. Only used by `npm run index:products` (scripts/index-algolia.ts)
# to build/configure the Algolia index from public/data/products.json + reviews.json.
ALGOLIA_WRITE_API_KEY=
